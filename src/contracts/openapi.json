{
  "openapi": "3.1.0",
  "info": {
    "title": "Mkt Control API",
    "version": "0.1.0",
    "description": "Sessão por cookie HTTP-only com token opaco guardado no banco. Requisições que alteram estado (exceto as rotas públicas de login, cadastro e recuperação de senha) exigem o cabeçalho anti-CSRF com o valor do cookie mkt_csrf."
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mkt_session"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "ADMIN",
                  "CASHIER"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "role"
            ],
            "additionalProperties": false
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "SetupResponse": {
        "type": "object",
        "properties": {
          "hasStore": {
            "type": "boolean"
          }
        },
        "required": [
          "hasStore"
        ],
        "additionalProperties": false
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "allOf": [
              {
                "pattern": "\\p{L}"
              },
              {
                "pattern": "\\d"
              }
            ]
          },
          "storeName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "document": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "maxLength": 20
          },
          "kind": {
            "type": "string",
            "enum": [
              "Mercadinho",
              "Padaria",
              "Açougue",
              "Hortifrúti",
              "Loja de conveniência",
              "Outro"
            ]
          },
          "terms": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "storeName",
          "document",
          "kind",
          "terms"
        ]
      },
      "SignupVerifyRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "SignupResendRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetConfirmRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "allOf": [
              {
                "pattern": "\\p{L}"
              },
              {
                "pattern": "\\d"
              }
            ]
          }
        },
        "required": [
          "email",
          "code",
          "password"
        ]
      },
      "AccountResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "ADMIN",
                  "CASHIER"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "role"
            ],
            "additionalProperties": false
          },
          "store": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "user",
          "store"
        ],
        "additionalProperties": false
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "current": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "next": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "allOf": [
              {
                "pattern": "\\p{L}"
              },
              {
                "pattern": "\\d"
              }
            ]
          }
        },
        "required": [
          "current",
          "next"
        ]
      },
      "RevokedSessions": {
        "type": "object",
        "properties": {
          "revoked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "revoked"
        ],
        "additionalProperties": false
      },
      "StoreResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "document": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "sessionIdle": {
            "type": "string",
            "enum": [
              "1h",
              "8h",
              "24h",
              "never"
            ]
          }
        },
        "required": [
          "name",
          "document",
          "phone",
          "address",
          "sessionIdle"
        ],
        "additionalProperties": false
      },
      "UpdateStoreRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "document": {
            "type": "string"
          },
          "phone": {
            "default": "",
            "type": "string",
            "maxLength": 20
          },
          "address": {
            "default": "",
            "type": "string",
            "maxLength": 200
          },
          "sessionIdle": {
            "type": "string",
            "enum": [
              "1h",
              "8h",
              "24h",
              "never"
            ]
          }
        },
        "required": [
          "name",
          "document",
          "sessionIdle"
        ]
      },
      "UserRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "CASHIER"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "lastLoginAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "pending": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "role",
          "active",
          "lastLoginAt",
          "pending"
        ],
        "additionalProperties": false
      },
      "UsersList": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "ADMIN",
                    "CASHIER"
                  ]
                },
                "active": {
                  "type": "boolean"
                },
                "lastLoginAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pending": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "name",
                "email",
                "role",
                "active",
                "lastLoginAt",
                "pending"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "users"
        ],
        "additionalProperties": false
      },
      "InviteUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "CASHIER"
            ]
          }
        },
        "required": [
          "name",
          "email",
          "role"
        ]
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "CASHIER"
            ]
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "ThemeRequest": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ]
          }
        },
        "required": [
          "theme"
        ]
      },
      "ActivityPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "userName": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "at",
                "userName",
                "action",
                "detail"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "FormError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/setup": {
      "get": {
        "summary": "Informa se a loja já foi criada",
        "description": "Público. As telas usam para oferecer ou esconder \"Criar conta da loja\".",
        "responses": {
          "200": {
            "description": "Estado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupResponse"
                }
              }
            }
          },
          "403": {
            "description": "Origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/theme": {
      "post": {
        "summary": "Guarda a escolha de tema (claro, escuro ou sistema)",
        "description": "Público. Define o cookie mkt_theme (HTTP-only, 1 ano) que o servidor aplica em <html data-theme>; \"system\" apaga o cookie e o app volta a seguir o sistema.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ThemeRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Escolha gravada (ou apagada)."
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Autentica o administrador e abre a sessão",
        "description": "Limite de 10 tentativas por IP a cada 15 minutos; a 11ª recebe 429. Com remember=true os cookies duram 30 dias deslizantes; sem, acabam com o navegador (12 h no servidor). Se a requisição já tem sessão, ela é encerrada.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão criada; define os cookies mkt_session (HTTP-only) e mkt_csrf.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "E-mail ou senha incorretos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Acesso desativado, perfil sem acesso ao painel (CASHIER) ou origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite de tentativas excedido.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima tentativa.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Encerra a sessão",
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "responses": {
          "204": {
            "description": "Cookies de sessão removidos."
          },
          "401": {
            "description": "Sem sessão válida; os cookies também são removidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cabeçalho anti-CSRF ausente ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "summary": "Pede o cadastro da loja e envia o código por e-mail",
        "description": "Só enquanto não há loja. Grava o pedido e envia um código de 6 dígitos (10 min, 5 tentativas). Novo pedido para o mesmo e-mail só após 60 s. Limite de 10 por IP a cada 15 minutos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Código enviado; define o cookie mkt_signup (HTTP-only, Path=/api/auth/signup, 10 min) que prova que este navegador iniciou o cadastro."
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A loja já foi criada, ou o e-mail já tem conta (fields.email).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "422": {
            "description": "Campos inválidos (fields).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "429": {
            "description": "Limite excedido ou novo código antes de 60 s.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima tentativa.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup/verify": {
      "post": {
        "summary": "Confirma o código, cria a loja e o administrador e abre a sessão",
        "description": "Limite de 10 por IP a cada 15 minutos. Cinco códigos errados bloqueiam o código. Exige o cookie mkt_signup do cadastro; ele é removido ao concluir.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conta criada; define os cookies mkt_session (HTTP-only) e mkt_csrf.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
