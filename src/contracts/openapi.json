{
  "openapi": "3.1.0",
  "info": {
    "title": "Mkt Control API",
    "version": "0.1.0",
    "description": "Sessão por cookie HTTP-only com token opaco guardado no banco. Requisições que alteram estado (exceto as rotas públicas de login, cadastro e recuperação de senha) exigem o cabeçalho anti-CSRF com o valor do cookie mkt_csrf."
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "mkt_session"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "x-csrf-token"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "remember": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "ADMIN",
                  "CASHIER"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "role"
            ],
            "additionalProperties": false
          },
          "csrfToken": {
            "type": "string"
          }
        },
        "required": [
          "user",
          "csrfToken"
        ],
        "additionalProperties": false
      },
      "SetupResponse": {
        "type": "object",
        "properties": {
          "hasStore": {
            "type": "boolean"
          }
        },
        "required": [
          "hasStore"
        ],
        "additionalProperties": false
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "allOf": [
              {
                "pattern": "\\p{L}"
              },
              {
                "pattern": "\\d"
              }
            ]
          },
          "storeName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "document": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "maxLength": 20
          },
          "kind": {
            "type": "string",
            "enum": [
              "Mercadinho",
              "Padaria",
              "Açougue",
              "Hortifrúti",
              "Loja de conveniência",
              "Outro"
            ]
          },
          "terms": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "storeName",
          "document",
          "kind",
          "terms"
        ]
      },
      "SignupVerifyRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "SignupResendRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          }
        },
        "required": [
          "email"
        ]
      },
      "PasswordResetConfirmRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{6}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 256,
            "allOf": [
              {
                "pattern": "\\p{L}"
              },
              {
                "pattern": "\\d"
              }
            ]
          }
        },
        "required": [
          "email",
          "code",
          "password"
        ]
      },
      "UsersList": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "ADMIN",
                    "CASHIER"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "email",
                "role"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "users"
        ],
        "additionalProperties": false
      },
      "ActivityPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                "userName": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "at",
                "userName",
                "action",
                "detail"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "FormError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "fields": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/setup": {
      "get": {
        "summary": "Informa se a loja já foi criada",
        "description": "Público. As telas usam para oferecer ou esconder \"Criar conta da loja\".",
        "responses": {
          "200": {
            "description": "Estado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupResponse"
                }
              }
            }
          },
          "403": {
            "description": "Origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Autentica o administrador e abre a sessão",
        "description": "Limite de 10 tentativas por IP a cada 15 minutos; a 11ª recebe 429. Com remember=true os cookies duram 30 dias deslizantes; sem, acabam com o navegador (12 h no servidor). Se a requisição já tem sessão, ela é encerrada.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessão criada; define os cookies mkt_session (HTTP-only) e mkt_csrf.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "E-mail ou senha incorretos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Acesso desativado, perfil sem acesso ao painel (CASHIER) ou origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite de tentativas excedido.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima tentativa.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Encerra a sessão",
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "responses": {
          "204": {
            "description": "Cookies de sessão removidos."
          },
          "401": {
            "description": "Sem sessão válida; os cookies também são removidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cabeçalho anti-CSRF ausente ou inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "summary": "Pede o cadastro da loja e envia o código por e-mail",
        "description": "Só enquanto não há loja. Grava o pedido e envia um código de 6 dígitos (10 min, 5 tentativas). Novo pedido para o mesmo e-mail só após 60 s. Limite de 10 por IP a cada 15 minutos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Código enviado; define o cookie mkt_signup (HTTP-only, Path=/api/auth/signup, 10 min) que prova que este navegador iniciou o cadastro."
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A loja já foi criada, ou o e-mail já tem conta (fields.email).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "422": {
            "description": "Campos inválidos (fields).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "429": {
            "description": "Limite excedido ou novo código antes de 60 s.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima tentativa.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup/verify": {
      "post": {
        "summary": "Confirma o código, cria a loja e o administrador e abre a sessão",
        "description": "Limite de 10 por IP a cada 15 minutos. Cinco códigos errados bloqueiam o código. Exige o cookie mkt_signup do cadastro; ele é removido ao concluir.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupVerifyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Conta criada; define os cookies mkt_session (HTTP-only) e mkt_csrf.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A loja já foi criada, o e-mail já tem conta, ou o cadastro expirou/foi substituído (cookie ausente ou diferente).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "422": {
            "description": "Código incorreto, expirado ou campos inválidos (fields).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "429": {
            "description": "Limite de tentativas excedido.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima tentativa.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup/resend": {
      "post": {
        "summary": "Reenvia o código do cadastro",
        "description": "No máximo um código por minuto para o mesmo e-mail. Exige o cookie mkt_signup do cadastro.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignupResendRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Código enviado."
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Não há cadastro em andamento para o e-mail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A loja já foi criada, o e-mail já tem conta, ou o cadastro expirou/foi substituído (cookie ausente ou diferente).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "422": {
            "description": "E-mail inválido (fields).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "429": {
            "description": "Limite excedido ou novo código antes de 60 s.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima tentativa.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/password-reset": {
      "post": {
        "summary": "Pede um código de redefinição de senha",
        "description": "Responde 202 do mesmo jeito exista ou não conta ativa com o e-mail (sem enumeração).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Se houver conta, o código chega por e-mail."
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "E-mail inválido (fields).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "429": {
            "description": "Limite de tentativas excedido.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima tentativa.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/password-reset/confirm": {
      "post": {
        "summary": "Redefine a senha com o código",
        "description": "Troca a senha, consome o código e encerra todas as sessões do usuário. Qualquer falha do código tem a mesma mensagem.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordResetConfirmRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Senha redefinida."
          },
          "400": {
            "description": "Corpo inválido.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Origem diferente do servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Código inválido ou expirado, ou campos inválidos (fields).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormError"
                }
              }
            }
          },
          "429": {
            "description": "Limite de tentativas excedido.",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima tentativa.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/users": {
      "get": {
        "summary": "Lista os usuários (somente ADMIN)",
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuários.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersList"
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Perfil sem permissão (CASHIER).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/activity": {
      "get": {
        "summary": "Registro de atividade, do mais recente ao mais antigo (somente ADMIN)",
        "description": "50 itens por página. Envie nextCursor, sem alterá-lo, em ?cursor= para a página seguinte.",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página.",
            "content": {
              "application/json": {
                "schema": {
