# Copy to the ignored .env.production on the server and fill it in (docs/deploy.md).
# Read by compose.prod.yaml through --env-file. Never commit the real file.

# The production database container. The password goes into DATABASE_URL, so keep it long,
# random and URL-safe, e.g. the output of: openssl rand -hex 32
POSTGRES_USER=mkt
POSTGRES_PASSWORD=
POSTGRES_DB=mkt_control

# Ports on this computer, both bound to loopback (127.0.0.1).
POSTGRES_PORT=5433
APP_PORT=3000

# Required in production: sign-up codes, password recovery and the daily summary go by e-mail.
RESEND_API_KEY=
# A sender on a domain verified at Resend, e.g. Mkt Control <nao-responda@sualoja.com.br>
MAIL_FROM=
LOG_LEVEL=info
