# Copy to the ignored .env.local and fill in local values. Never use NEXT_PUBLIC_* for secrets.
# Loaded by Next.js and drizzle-kit (@next/env) and by Docker Compose via `npm run db:up`.

# Local PostgreSQL container (compose.yaml). Use a long random password.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Runtime connection used by the app and drizzle-kit; keep it in sync with the values above.
# Example shape: postgresql://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=
# Optional direct connection for migration providers that require it.
DATABASE_URL_UNPOOLED=
# Separate database on the same server for `npm run test:db` (create it once, see docs/onboarding.md).
# Tests run inside rolled-back transactions; never point this at real data.
DATABASE_URL_TEST=
LOG_LEVEL=info

# Session JWT signing key (HS256): 32+ random characters, never committed.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
